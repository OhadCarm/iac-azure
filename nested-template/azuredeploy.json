{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Parent template that orchestrates two nested (inline) deployments: one creates a storage account, the second creates a blob container inside it. Demonstrates Microsoft.Resources/deployments, inner-scope modules, passing a child's output into the next child, and surfacing nested outputs to the parent."
  },
  "parameters": {
    "project": {
      "type": "string",
      "defaultValue": "contoso",
      "minLength": 3,
      "maxLength": 11,
      "metadata": { "description": "Short lowercase project code used in the storage account name." }
    },
    "environment": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": [ "dev", "test", "prod" ]
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    }
  },
  "variables": {
    "salt": "[uniqueString(resourceGroup().id)]",
    "storageAccountName": "[toLower(take(concat(parameters('project'), parameters('environment'), variables('salt')), 24))]",
    "containerName": "app-data"
  },
  "resources": [
    {
      "comments": "CHILD DEPLOYMENT 1 — creates the storage account from an inline nested template.",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "deploy-storage",
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "storageAccountName": { "value": "[variables('storageAccountName')]" },
          "location": { "value": "[parameters('location')]" }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "storageAccountName": { "type": "string" },
            "location": { "type": "string" }
          },
          "resources": [
            {
              "type": "Microsoft.Storage/storageAccounts",
              "apiVersion": "2023-01-01",
              "name": "[parameters('storageAccountName')]",
              "location": "[parameters('location')]",
              "sku": { "name": "Standard_LRS" },
              "kind": "StorageV2",
              "properties": {
                "minimumTlsVersion": "TLS1_2",
                "supportsHttpsTrafficOnly": true,
                "allowBlobPublicAccess": false,
                "publicNetworkAccess": "Disabled"
              }
            }
          ],
          "outputs": {
            "storageAccountName": {
              "type": "string",
              "value": "[parameters('storageAccountName')]"
            },
            "storageAccountId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
            }
          }
        }
      }
    },
    {
      "comments": "CHILD DEPLOYMENT 2 — creates a blob container. Its storageAccountName parameter is fed from deployment 1's OUTPUT, and it dependsOn deployment 1 so ordering is guaranteed.",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "deploy-container",
      "dependsOn": [
        "deploy-storage"
      ],
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "storageAccountName": { "value": "[reference('deploy-storage').outputs.storageAccountName.value]" },
          "containerName": { "value": "[variables('containerName')]" }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "storageAccountName": { "type": "string" },
            "containerName": { "type": "string" }
          },
          "resources": [
            {
              "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
              "apiVersion": "2023-01-01",
              "name": "[format('{0}/default/{1}', parameters('storageAccountName'), parameters('containerName'))]",
              "properties": {
                "publicAccess": "None"
              }
            }
          ],
          "outputs": {
            "containerId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', parameters('storageAccountName'), 'default', parameters('containerName'))]"
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "storageAccountName": {
      "type": "string",
      "value": "[reference('deploy-storage').outputs.storageAccountName.value]"
    },
    "storageAccountId": {
      "type": "string",
      "value": "[reference('deploy-storage').outputs.storageAccountId.value]"
    },
    "containerId": {
      "type": "string",
      "value": "[reference('deploy-container').outputs.containerId.value]"
    }
  }
}
