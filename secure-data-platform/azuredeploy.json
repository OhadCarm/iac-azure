{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Secure data-platform baseline: a user-assigned managed identity, N storage accounts (one per purpose, via a copy loop), a Key Vault, and the RBAC role assignments that grant the identity access to each. Demonstrates custom functions, ARM functions, parameters, and multiple instances of one resource type."
  },
  "parameters": {
    "project": {
      "type": "string",
      "defaultValue": "contoso",
      "minLength": 3,
      "maxLength": 8,
      "metadata": {
        "description": "Short lowercase project/workload code. Used across all resource names."
      }
    },
    "environment": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": [ "dev", "test", "prod" ],
      "metadata": {
        "description": "Deployment environment. Drives storage redundancy and Key Vault purge protection."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region. Defaults to the resource group's region."
      }
    },
    "storagePurposes": {
      "type": "array",
      "defaultValue": [ "data", "diag", "archive" ],
      "metadata": {
        "description": "One storage account is created per entry (demonstrates a resource copy loop)."
      }
    },
    "extraTags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Additional tags merged on top of the standard set."
      }
    }
  },
  "functions": [
    {
      "namespace": "naming",
      "members": {
        "stg": {
          "parameters": [
            { "name": "project", "type": "string" },
            { "name": "env", "type": "string" },
            { "name": "purpose", "type": "string" },
            { "name": "salt", "type": "string" }
          ],
          "output": {
            "type": "string",
            "value": "[toLower(take(concat(parameters('project'), parameters('env'), parameters('purpose'), parameters('salt')), 24))]"
          }
        },
        "global": {
          "parameters": [
            { "name": "prefix", "type": "string" },
            { "name": "project", "type": "string" },
            { "name": "env", "type": "string" },
            { "name": "salt", "type": "string" }
          ],
          "output": {
            "type": "string",
            "value": "[toLower(take(format('{0}-{1}-{2}-{3}', parameters('prefix'), parameters('project'), parameters('env'), parameters('salt')), 24))]"
          }
        },
        "resource": {
          "parameters": [
            { "name": "project", "type": "string" },
            { "name": "env", "type": "string" },
            { "name": "kind", "type": "string" }
          ],
          "output": {
            "type": "string",
            "value": "[toLower(format('{0}-{1}-{2}', parameters('project'), parameters('env'), parameters('kind')))]"
          }
        }
      }
    }
  ],
  "variables": {
    "salt": "[uniqueString(resourceGroup().id)]",
    "identityName": "[naming.resource(parameters('project'), parameters('environment'), 'id')]",
    "keyVaultName": "[naming.global('kv', parameters('project'), parameters('environment'), variables('salt'))]",
    "storageBlobDataContributorRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
    "keyVaultSecretsUserRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]",
    "commonTags": {
      "project": "[parameters('project')]",
      "environment": "[parameters('environment')]",
      "managedBy": "arm-template"
    },
    "resourceTags": "[union(variables('commonTags'), parameters('extraTags'))]",
    "copy": [
      {
        "name": "storageAccountNames",
        "count": "[length(parameters('storagePurposes'))]",
        "input": "[naming.stg(parameters('project'), parameters('environment'), parameters('storagePurposes')[copyIndex('storageAccountNames')], variables('salt'))]"
      }
    ]
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('identityName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('resourceTags')]"
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageAccountNames')[copyIndex()]]",
      "location": "[parameters('location')]",
      "copy": {
        "name": "storageAccounts",
        "count": "[length(parameters('storagePurposes'))]"
      },
      "sku": {
        "name": "[if(equals(parameters('environment'), 'prod'), 'Standard_GRS', 'Standard_LRS')]"
      },
      "kind": "StorageV2",
      "properties": {
        "accessTier": "Hot",
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "allowBlobPublicAccess": false,
        "publicNetworkAccess": "Disabled",
        "networkAcls": {
          "defaultAction": "Deny",
          "bypass": "AzureServices"
        }
      },
      "tags": "[variables('resourceTags')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountNames')[copyIndex()]), variables('identityName'), 'blob-data-contributor')]",
      "scope": "[format('Microsoft.Storage/storageAccounts/{0}', variables('storageAccountNames')[copyIndex()])]",
      "copy": {
        "name": "storageRoleAssignments",
        "count": "[length(parameters('storagePurposes'))]"
      },
      "dependsOn": [
        "storageAccounts",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('storageBlobDataContributorRoleId')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "tenantId": "[subscription().tenantId]",
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 90,
        "enablePurgeProtection": "[if(equals(parameters('environment'), 'prod'), true(), null())]",
        "publicNetworkAccess": "Disabled",
        "networkAcls": {
          "defaultAction": "Deny",
          "bypass": "AzureServices"
        }
      },
      "tags": "[variables('resourceTags')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), variables('identityName'), 'kv-secrets-user')]",
      "scope": "[format('Microsoft.KeyVault/vaults/{0}', variables('keyVaultName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('keyVaultSecretsUserRoleId')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "managedIdentityName": {
      "type": "string",
      "value": "[variables('identityName')]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').principalId]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[variables('keyVaultName')]"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), '2023-07-01').vaultUri]"
    },
    "storageAccountNames": {
      "type": "array",
      "value": "[variables('storageAccountNames')]"
    },
    "storageAccountCount": {
      "type": "int",
      "value": "[length(variables('storageAccountNames'))]"
    }
  }
}
